
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DAXX BANNA 11</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#101522;
 color:white;
 font-family:Georgia,"Times New Roman",serif;
}
header{
 background:#192338;
 padding:18px;
 text-align:center;
}
h1{color:#71b7ff;margin:0;font-size:25px}
main{max-width:900px;margin:auto;padding:16px}
.card{
 background:#202c42;
 padding:16px;
 border-radius:12px;
 margin:14px 0;
}
input,button{
 font-family:inherit;
 font-size:15px;
 border-radius:8px;
 padding:12px;
}
input{
 width:100%;
 margin:7px 0;
 border:1px solid #52627c;
 background:#101522;
 color:white;
}
button{
 border:0;
 background:#3488ed;
 color:white;
 cursor:pointer;
 margin:4px;
}
button:disabled{opacity:.5}
.secondary{background:#45536b}
.danger{background:#c44242}
.hidden{display:none!important}
.categories{
 display:flex;
 flex-wrap:wrap;
 gap:6px;
}
.category{flex:1 1 100px}
.file{
 background:#192338;
 padding:12px;
 border-radius:9px;
 margin:9px 0;
 display:flex;
 align-items:center;
 gap:9px;
}
.file-name{flex:1;overflow-wrap:anywhere}
.file-actions{display:flex;flex-wrap:wrap}
.small{font-size:13px;color:#b9c7dc}
#message{white-space:pre-wrap;color:#8fc6ff}
#preview{
 position:fixed;
 inset:0;
 z-index:10;
 background:#080d17ee;
 display:flex;
 align-items:center;
 justify-content:center;
 padding:15px;
}
#previewContent{
 width:100%;
 max-width:850px;
 max-height:90vh;
 overflow:auto;
 background:#202c42;
 padding:15px;
 border-radius:12px;
}
#previewContent img,#previewContent video{
 max-width:100%;
 max-height:70vh;
 display:block;
 margin:auto;
}
#previewContent audio{width:100%}
</style>
</head>

<body>
<header>
 <h1>DAXX BANNA 11</h1>
 <div class="small">Secure Cloud Storage</div>
</header>

<main>

<section id="loginBox" class="card">
 <h2>Login</h2>
 <input id="userId" placeholder="User ID" autocomplete="username">
 <input id="password" type="password" placeholder="Password" autocomplete="current-password">
 <button id="loginBtn" onclick="login()">Login</button>
 <p id="loginMessage" class="small"></p>
</section>

<section id="dashboard" class="hidden">
 <div class="card">
  <h2>My Storage</h2>
  <p id="storageText">Storage information loading...</p>
  <button onclick="loadStorage()">Refresh Storage</button>
  <button class="secondary" onclick="connectDrive()">Connect Google Drive</button>
  <button class="danger" onclick="logout()">Logout</button>
 </div>

 <div class="card">
  <h3>Categories</h3>
  <div class="categories">
   <button class="category" onclick="openCategory('Photos')">📷 Photos</button>
   <button class="category" onclick="openCategory('Videos')">🎬 Videos</button>
   <button class="category" onclick="openCategory('Music')">🎵 Music</button>
   <button class="category" onclick="openCategory('Documents')">📄 Documents</button>
   <button class="category" onclick="openCategory('Other')">📁 Other</button>
  </div>
 </div>

 <div class="card">
  <h3 id="folderTitle">Photos</h3>
  <input id="fileInput" type="file" multiple>
  <button onclick="uploadFiles()">Upload Files</button>
  <button class="secondary" onclick="loadFiles()">Refresh Files</button>
  <button class="danger" onclick="deleteSelected()">Delete Selected</button>
  <p id="uploadStatus" class="small"></p>
  <p id="fileCount" class="small"></p>
  <div id="fileList"></div>
 </div>
</section>

<div id="preview" class="hidden" onclick="closePreview(event)">
 <div id="previewContent" onclick="event.stopPropagation()">
  <button class="danger" onclick="closePreview()">Close</button>
  <div id="previewBody"></div>
 </div>
</div>

<p id="message"></p>
</main>

<script>
const API =
"https://dsxmzcicvjtzlrvjbnpr.supabase.co/functions/v1/daxu-login";

let token = sessionStorage.getItem("daxx_session") || "";
let currentFolder = "Photos";
let currentFiles = [];
let selectedFiles = new Set();
let previewUrl = null;

function showMessage(text){
 document.getElementById("message").textContent = text || "";
}

function setLoggedIn(value){
 document.getElementById("loginBox").classList.toggle("hidden",value);
 document.getElementById("dashboard").classList.toggle("hidden",!value);
}

async function api(data){
 const response = await fetch(API,{
  method:"POST",
  headers:{
   "Content-Type":"application/json",
   "Authorization":"Bearer "+token
  },
  body:JSON.stringify(data)
 });

 const result = await response.json().catch(()=>({}));
 if(!response.ok || result.error){
  throw new Error(result.error || result.message || "Request failed");
 }
 return result;
}

async function login(){
 const id = document.getElementById("userId").value.trim();
 const pass = document.getElementById("password").value;
 const button = document.getElementById("loginBtn");
 const output = document.getElementById("loginMessage");

 if(!id || !pass){
  output.textContent = "User ID aur Password bharo.";
  return;
 }

 button.disabled = true;
 output.textContent = "Logging in...";

 try{
  const response = await fetch(API,{
   method:"POST",
   headers:{"Content-Type":"application/json"},
   body:JSON.stringify({
    action:"login",
    userId:id,
    password:pass
   })
  });

  const data = await response.json();
  if(!response.ok || data.error) throw new Error(data.error || "Login failed");
  if(!data.token) throw new Error("Login token nahi mila.");

  token = data.token;
  sessionStorage.setItem("daxx_session",token);
  document.getElementById("password").value = "";
  output.textContent = "";
  setLoggedIn(true);

  await loadFiles();
  await loadStorage();
 }catch(error){
  output.textContent = error.message;
 }finally{
  button.disabled = false;
 }
}

async function connectDrive(){
 try{
  const data = await api({action:"connect-url"});
  if(!data.url) throw new Error("Google connection URL nahi mila.");
  window.location.href = data.url;
 }catch(error){
  showMessage(error.message);
 }
}

function logout(){
 token = "";
 sessionStorage.removeItem("daxx_session");
 currentFiles = [];
 selectedFiles.clear();
 setLoggedIn(false);
 showMessage("You have logged out.");
}

function openCategory(name){
 currentFolder = name;
 document.getElementById("folderTitle").textContent = name;
 selectedFiles.clear();
 loadFiles();
}

async function loadFiles(){
 if(!token) return;

 const list = document.getElementById("fileList");
 list.textContent = "Loading files...";

 try{
  const data = await api({
   action:"list",
   folder:currentFolder
  });

  currentFiles = Array.isArray(data.files) ? data.files :
   Array.isArray(data) ? data : [];

  selectedFiles.clear();
  renderFiles();
 }catch(error){
  list.textContent = error.message;
 }
}

function renderFiles(){
 const list = document.getElementById("fileList");
 list.innerHTML = "";
 document.getElementById("fileCount").textContent =
 currentFiles.length + " file(s)";

 if(currentFiles.length === 0){
  list.textContent = "Is folder mein abhi koi file nahi hai.";
  return;
 }

 currentFiles.forEach(file=>{
  const id = file.id;
  const name = file.name || "Unnamed file";

  const row = document.createElement("div");
  row.className = "file";

  const checkbox = document.createElement("input");
  checkbox.type = "checkbox";
  checkbox.style.width = "20px";
  checkbox.checked = selectedFiles.has(id);
  checkbox.onchange = ()=>{
   if(checkbox.checked) selectedFiles.add(id);
   else selectedFiles.delete(id);
  };

  const label = document.createElement("div");
  label.className = "file-name";
  label.textContent = name;

  const actions = document.createElement("div");
  actions.className = "file-actions";

  const openBtn = document.createElement("button");
  openBtn.textContent = "Open";
  openBtn.onclick = ()=>previewFile(file);

  const downloadBtn = document.createElement("button");
  downloadBtn.textContent = "Download";
  downloadBtn.onclick = ()=>downloadFile(file);

  const deleteBtn = document.createElement("button");
  deleteBtn.textContent = "Delete";
  deleteBtn.className = "danger";
  deleteBtn.onclick = ()=>deleteFile(file);

  actions.append(openBtn,downloadBtn,deleteBtn);
  row.append(checkbox,label,actions);
  list.appendChild(row);
 });
}

async function uploadFiles(){
 const input = document.getElementById("fileInput");
 const files = Array.from(input.files || []);
 const status = document.getElementById("uploadStatus");

 if(!files.length){
  status.textContent = "Pehle files select karo.";
  return;
 }

 try{
  for(let i=0;i<files.length;i++){
   const file = files[i];
   status.textContent = "Uploading " + (i+1) + "/" + files.length + ": " + file.name;

   const params = new URLSearchParams({
    action:"upload",
    folder:currentFolder,
    name:file.name
   });

   const response = await fetch(API+"?"+params.toString(),{
    method:"POST",
    headers:{
     "Authorization":"Bearer "+token,
     "Content-Type":file.type || "application/octet-stream"
    },
    body:file
   });

   const result = await response.json().catch(()=>({}));
   if(!response.ok || result.error){
    throw new Error(result.error || "Upload failed: "+file.name);
   }
  }

  status.textContent = "Upload complete!";
  input.value = "";
  await loadFiles();
  await loadStorage();
 }catch(error){
  status.textContent = error.message;
 }
}

async function downloadBlob(file){
 const params = new URLSearchParams({
  action:"download",
  fileId:file.id
 });

 const response = await fetch(API+"?"+params.toString(),{
  headers:{"Authorization":"Bearer "+token}
 });

 if(!response.ok){
  const error = await response.json().catch(()=>({}));
  throw new Error(error.error || "Download failed");
 }

 return await response.blob();
}

async function downloadFile(file){
 try{
  showMessage("Downloading "+file.name+"...");
  const blob = await downloadBlob(file);
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = file.name || "download";
  document.body.appendChild(link);
  link.click();
  link.remove();
  setTimeout(()=>URL.revokeObjectURL(url),60000);
  showMessage("Download started.");
 }catch(error){
  showMessage(error.message);
 }
}

async function previewFile(file){
 try{
  showMessage("Opening "+file.name+"...");
  const blob = await downloadBlob(file);
  if(previewUrl) URL.revokeObjectURL(previewUrl);
  previewUrl = URL.createObjectURL(blob);

  const type = file.mimeType || blob.type || "";
  const body = document.getElementById("previewBody");
  body.innerHTML = "";

  if(type.startsWith("image/")){
   const img = document.createElement("img");
   img.src = previewUrl;
   body.appendChild(img);
  }else if(type.startsWith("video/")){
   const video = document.createElement("video");
   video.src = previewUrl;
   video.controls = true;
   body.appendChild(video);
  }else if(type.startsWith("audio/")){
   const audio = document.createElement("audio");
   audio.src = previewUrl;
   audio.controls = true;
   body.appendChild(audio);
  }else{
   const message = document.createElement("p");
   message.textContent = "Is file ka preview available nahi hai. Download button se file khol sakte ho.";
   body.appendChild(message);

   const link = document.createElement("a");
   link.href = previewUrl;
   link.download = file.name || "download";
   link.textContent = "Download / Open File";
   link.style.color = "#71b7ff";
   body.appendChild(link);
  }

  document.getElementById("preview").classList.remove("hidden");
  showMessage("");
 }catch(error){
  showMessage(error.message);
 }
}

function closePreview(event){
 if(event && event.target !== document.getElementById("preview")) return;
 document.getElementById("preview").classList.add("hidden");
 document.getElementById("previewBody").innerHTML = "";
 if(previewUrl){
  URL.revokeObjectURL(previewUrl);
  previewUrl = null;
 }
}

async function deleteFile(file){
 if(!confirm("Delete "+file.name+"?")) return;

 try{
  await api({action:"delete",fileId:file.id});
  selectedFiles.delete(file.id);
  await loadFiles();
  await loadStorage();
  showMessage("File deleted.");
 }catch(error){
  showMessage(error.message);
 }
}

async function deleteSelected(){
 const ids = Array.from(selectedFiles);
 if(!ids.length){
  showMessage("Pehle files select karo.");
  return;
 }

 if(!confirm(ids.length+" selected files delete karein?")) return;

 try{
  for(const id of ids){
   await api({action:"delete",fileId:id});
  }
  selectedFiles.clear();
  await loadFiles();
  await loadStorage();
  showMessage("Selected files deleted.");
 }catch(error){
  showMessage(error.message);
 }
}

function formatBytes(bytes){
 const value = Number(bytes);
 if(!Number.isFinite(value) || value < 0) return "Unknown";
 if(value === 0) return "0 B";
 const units = ["B","KB","MB","GB","TB"];
 const i = Math.floor(Math.log(value)/Math.log(1024));
 return (value/Math.pow(1024,i)).toFixed(2)+" "+units[i];
}

async function loadStorage(){
 if(!token) return;

 const output = document.getElementById("storageText");
 output.textContent = "Loading...";

 try{
  const data = await api({action:"storage"});
  const used = Number(data.usage);
  const limit = Number(data.limit);

  if(!Number.isFinite(used) || !Number.isFinite(limit) || limit <= 0){
   output.textContent = "Storage details available nahi hain.";
   return;
  }

  output.textContent =
   "Used: "+formatBytes(used)+
   " | Total: "+formatBytes(limit)+
   " | Available: "+formatBytes(Math.max(0,limit-used));
 }catch(error){
  output.textContent = error.message;
 }
}

async function startApp(){
 const params = new URLSearchParams(window.location.search);

 if(params.get("drive") === "connected"){
  window.history.replaceState({},document.title,window.location.pathname);
  showMessage("Google Drive connection callback received. Refreshing files...");
 }

 if(token){
  setLoggedIn(true);
  await loadFiles();
  await loadStorage();
 }else{
  setLoggedIn(false);
 }
}

startApp();
</script>
</body>
</html>
